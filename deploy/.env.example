# Compose settings only. Real .env and app/.env stay on the server.
# Pin a verified published runtime with pcntl before deploying this revision.
PHP_IMAGE=ghcr.io/sirtimon/amfot-php:sha-REPLACE_WITH_VERIFIED_BUILD
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Must be lower than Laravel's effective database retry_after (normally 90).
# For 300-second jobs configure retry_after=360 in the separate application first.
QUEUE_WORKER_TIMEOUT=60
MYSQL_ROOT_PASSWORD=CHANGE_TO_RANDOM_SECRET
MYSQL_PASSWORD=CHANGE_TO_DIFFERENT_RANDOM_SECRET
